# Keep the Docker build context minimal AND deterministic.
#
# Why this file exists:
# Without a .dockerignore a local `node_modules/` (possibly including devDependencies,
# host-specific native bindings, or a different Chrome cache) would be copied OVER the
# freshly installed one, making the image non-reproducible and potentially breaking
# at runtime on Linux when built on macOS/Windows.

# Dependencies — re-installed inside the image
node_modules/

# Puppeteer / Chrome caches — re-downloaded inside the image at the pinned
# version (see PINNED_CHROME_VERSION in the Dockerfile)
.cache/
.local-chromium/

# Test / coverage output
coverage/
.nyc_output/
junit*.xml

# Editor / OS noise
.idea/
.vscode/
.DS_Store
Thumbs.db

# Logs and local env files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env
.env.*

# Docker / git metadata (not needed at runtime)
Dockerfile
.dockerignore
.git/
.gitignore

