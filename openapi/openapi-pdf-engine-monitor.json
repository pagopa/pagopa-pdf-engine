{
  "openapi": "3.0.1",
  "info": {
    "title": "PDF Engine - Unified Monitoring (Shared & PrintIT)",
    "version": "2.10.28-3-chore-sync-notice-templates"
  },
  "servers": [
    {
      "url": "${host}",
      "description": "Base host"
    }
  ],
  "paths": {
    "/shared/pdf-engine/v1/info": {
      "get": {
        "tags": [
          "Shared"
        ],
        "summary": "Health Check (Shared)",
        "operationId": "healthCheckShared",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/shared/pdf-engine/v1/generate-pdf": {
      "post": {
        "tags": [
          "Shared"
        ],
        "summary": "Create PDF (Shared)",
        "operationId": "createPdfShared",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/PdfEngineRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Bad Request"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/printit/pdf-engine/v1/info": {
      "get": {
        "tags": [
          "PrintIT"
        ],
        "summary": "Health Check (PrintIT)",
        "operationId": "healthCheckPrintIt",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/printit/pdf-engine/v1/generate-pdf": {
      "post": {
        "tags": [
          "PrintIT"
        ],
        "summary": "Create PDF (PrintIT)",
        "operationId": "createPdfPrintIt",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/PdfEngineRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Bad Request"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PdfEngineResponse": {
        "type": "object",
        "properties": {
          "errorId": {
            "type": "integer",
            "format": "int64"
          },
          "httpStatusDescription": {
            "type": "string"
          },
          "httpStatusCode": {},
          "appErrorCode": {},
          "errors": {}
        }
      },
      "PdfEngineRequest": {
        "required": [
          "template",
          "data"
        ],
        "type": "object",
        "properties": {
          "template": {
            "type": "string",
            "format": "binary"
          },
          "data": {
            "type": "string"
          },
          "applySignature": {
            "type": "boolean"
          },
          "generateZipped": {
            "type": "boolean"
          }
        }
      }
    },
    "securitySchemes": {
      "apiKeyHeader": {
        "type": "apiKey",
        "name": "Ocp-Apim-Subscription-Key",
        "in": "header"
      }
    }
  }
}
